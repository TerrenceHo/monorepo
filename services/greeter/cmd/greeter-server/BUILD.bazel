load("//bazel/go:default.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "greeter-server_lib",
    srcs = ["main.go"],
    importpath = "github.com/TerrenceHo/monorepo/services/greeter/cmd/greeter-server",
    visibility = ["//visibility:private"],
    deps = [
        "//proto/api/v1/greeter",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//reflection",
    ],
)

go_binary(
    name = "greeter-server",
    embed = [":greeter-server_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "greeter-server_test",
    srcs = ["main_test.go"],
    embed = [":greeter-server_lib"],
    deps = ["//proto/api/v1/greeter"],
)
